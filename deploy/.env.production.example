# ── Lumora production environment ────────────────────────────────────
# Copy to deploy/.env on the server and fill in real values.
# NEVER commit the filled-in .env.  cp .env.production.example .env

# ── Domains (no https:// prefix) ─────────────────────────────────────
SITE_DOMAIN=lumoradental.com
PMS_DOMAIN=pms.lumoradental.com
ACME_EMAIL=you@example.com          # for Let's Encrypt cert notices

# ── Database (internal to the compose network) ───────────────────────
POSTGRES_USER=dental_admin
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=dental_pms

# ── Auth ─────────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_generate_a_random_secret

# ── PMS public config ────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Lumora Dental Studio
NEXT_PUBLIC_DEFAULT_CURRENCY=LKR
NEXT_PUBLIC_USD_RATE=320

# ── Website public config ────────────────────────────────────────────
NEXT_PUBLIC_CLINIC_NAME=Lumora Dental Studio
NEXT_PUBLIC_CLINIC_PHONE=0761662434
NEXT_PUBLIC_CLINIC_EMAIL=lumoradentalstudio@gmail.com
NEXT_PUBLIC_CLINIC_ADDRESS=151/B Negambo Road, Minuwangoda
NEXT_PUBLIC_CLINIC_WHATSAPP=+94761662434

# ── AI features (PMS transcription/summarisation) ────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TRANSCRIBE_MAX_MB=25

# ── SMS — Notify.lk (optional) ───────────────────────────────────────
NOTIFY_LK_API_KEY=
NOTIFY_LK_USER_ID=
NOTIFY_LK_SENDER_ID=

# ── WhatsApp Business (optional) ─────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
